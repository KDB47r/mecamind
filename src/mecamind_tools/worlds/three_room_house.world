<?xml version="1.0" ?>
<!--
  三室户教学世界（轻量仿真版，约 11.7m x 8.85m，相对原版约 1.5 倍）。
  几何与 Gazebo three_room_house.sdf 保持一致。
-->
<sdf version="1.6">
  <world name="three_room_house">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <model name="house_shell">
      <static>true</static>
      <link name="north_wall">
        <pose>0 4.425 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>11.7 0.12 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>11.7 0.12 0.8</size></box></geometry></visual>
      </link>
      <link name="south_wall">
        <pose>0 -4.425 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>11.7 0.12 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>11.7 0.12 0.8</size></box></geometry></visual>
      </link>
      <link name="west_wall">
        <pose>-5.85 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 8.85 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8.85 0.8</size></box></geometry></visual>
      </link>
      <link name="east_wall">
        <pose>5.85 0 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 8.85 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 8.85 0.8</size></box></geometry></visual>
      </link>
      <link name="hall_divider_left">
        <pose>-1.8 1.5 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 4.8 0.8</size></box></geometry></visual>
      </link>
      <link name="hall_divider_right">
        <pose>2.1 -0.6 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.12 4.8 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 4.8 0.8</size></box></geometry></visual>
      </link>
      <link name="table">
        <pose>-3.9 2.25 0.18 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.0 1.0 0.36</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 0.36</size></box></geometry></visual>
      </link>
      <link name="cabinet">
        <pose>4.05 -2.7 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.75 1.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.75 1.2 0.5</size></box></geometry></visual>
      </link>
      <link name="pillar">
        <pose>0.75 -3.75 0.4 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.45 0.45 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.8</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
