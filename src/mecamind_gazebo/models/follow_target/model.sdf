<?xml version="1.0"?>
<!--
  视觉跟随用的红色圆柱目标。

  【尺寸】半径 0.10m（直径 0.2m）：控制器用该直径 + 相机视场角把
  画面宽度反算成真实距离做距离闭环（target_real_width=0.20 必须
  与这里保持一致，改半径要同步改参数）。

  static=true：位姿由 follow_target_mover 通过 gz set_pose 驱动。
-->
<sdf version="1.9">
  <model name="follow_target">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="body">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.05 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <emissive>0.85 0.0 0.0 1</emissive>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
